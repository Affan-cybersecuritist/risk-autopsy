GROQ_API_KEY=

# Required for the approval flow's server-side identity + face-match check
# (backend/auth.py). Without SUPABASE_SERVICE_ROLE_KEY set, POST
# /api/policy/approval-token fails closed with 503 rather than silently
# skipping the check - approvals cannot be minted at all until this is set.
# SUPABASE_URL / SUPABASE_ANON_KEY default to the values already public in
# webapp/src/lib/supabase.ts (the anon key is meant to be public); only the
# service role key is secret - get it from Supabase dashboard -> Project
# Settings -> API -> service_role (never expose this one to the frontend).
SUPABASE_URL=https://pitasanmfeumfmmloezz.supabase.co
SUPABASE_ANON_KEY=sb_publishable_t3lbR8vyvGLWVevyF1zfbA_8x4ejGdt
SUPABASE_SERVICE_ROLE_KEY=

# Optional: signs the short-lived (120s) approval token minted after a
# server-verified face match. If unset, a random secret is generated per
# process start - fine for a demo (outstanding tokens just don't survive a
# backend restart). Set this for a stable secret across restarts.
APPROVAL_TOKEN_SECRET=
