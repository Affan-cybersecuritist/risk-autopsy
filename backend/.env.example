GROQ_API_KEY=

# Used by the approval flow's server-side identity check (backend/auth.py),
# which re-verifies the Supabase session directly with Supabase rather than
# trusting the client. These default to the values already public in
# webapp/src/lib/supabase.ts (the anon key is meant to be public) so they
# only need to be set here if you're pointing at a different project.
SUPABASE_URL=https://pitasanmfeumfmmloezz.supabase.co
SUPABASE_ANON_KEY=sb_publishable_t3lbR8vyvGLWVevyF1zfbA_8x4ejGdt

# Optional: signs the short-lived (120s) approval token minted after a
# server-verified session check. If unset, a random secret is generated per
# process start - fine for a demo (outstanding tokens just don't survive a
# backend restart). Set this for a stable secret across restarts.
APPROVAL_TOKEN_SECRET=
